<!--
  TGVIS shared page-hero artwork.
  This is intentionally a lightweight SVG kept at the existing .png URL so
  every page can use the same stable asset without a build step. Replace it
  with an approved campus photograph when one is available.
-->
<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="800" viewBox="0 0 1920 800">
  <defs>
    <linearGradient id="background" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0b3d25;stop-opacity:1" />
      <stop offset="55%" style="stop-color:#12603a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#082b1b;stop-opacity:1" />
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="45%" r="60%">
      <stop offset="0%" style="stop-color:#d4a843;stop-opacity:.28" />
      <stop offset="100%" style="stop-color:#d4a843;stop-opacity:0" />
    </radialGradient>
    <pattern id="dots" width="54" height="54" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="2" fill="#fff" opacity=".12"/>
    </pattern>
  </defs>
  <rect width="1920" height="800" fill="url(#background)" />
  <rect width="1920" height="800" fill="url(#glow)" />
  <rect width="1920" height="800" fill="url(#dots)" />
  <path d="M0 680 C240 560 350 770 590 660 S1000 550 1220 675 S1640 790 1920 610 V800 H0Z" fill="#061f14" opacity=".45"/>
  <path d="M120 0 C290 120 235 230 390 320 M1800 0 C1600 160 1710 260 1500 380" fill="none" stroke="#d4a843" stroke-width="10" opacity=".16"/>
  <circle cx="960" cy="380" r="188" fill="none" stroke="#d4a843" stroke-width="3" opacity=".35"/>
  <circle cx="960" cy="380" r="164" fill="none" stroke="#fff" stroke-width="1" opacity=".18"/>
  <path d="M960 230 C875 300 875 460 960 530 C1045 460 1045 300 960 230Z" fill="#fff" opacity=".08"/>
  <path d="M960 260 V500 M900 330 C930 345 990 345 1020 330 M895 410 C930 425 990 425 1025 410" fill="none" stroke="#d4a843" stroke-width="4" opacity=".5"/>
</svg>
